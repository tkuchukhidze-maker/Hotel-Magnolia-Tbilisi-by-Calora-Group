APP_NAME="Hotel Magnolia Tbilisi by Calora Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# In production, choose a real transactional mail transport, e.g. SMTP or Resend.
# MAIL_HOST=...
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM_ADDRESS=bookings@your-verified-domain.example
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hotel Magnolia (see config/hotel.php)
HOTEL_PHONE_DISPLAY="+995 533 33 44 22"
HOTEL_PHONE_TEL=+995533334422
HOTEL_WHATSAPP=995533334422
HOTEL_EMAIL=hello@example.com
HOTEL_EMAIL_DISPLAY="[EMAIL]"
HOTEL_ADDRESS="5 Kirile Ukleba St"
HOTEL_BOOKINGS_EMAIL=hello@example.com
# Set this to the REAL hotel front-desk/manager mailbox in Laravel Cloud.
# Bookings email notifications are not delivered with MAIL_MAILER=log.
HOTEL_GOOGLE_MAPS="https://maps.google.com/?cid=15414144500935940587"
HOTEL_INSTAGRAM=
HOTEL_FACEBOOK=
HOTEL_BOOKING_COM=
# Book-direct offer: when HOTEL_OFFER_ENDS passes (Tbilisi time) prices return to full price.
HOTEL_OFFER_LABEL="Autumn at Magnolia"
HOTEL_OFFER_DISCOUNT=25
HOTEL_OFFER_ENDS="2026-11-30 23:59:59"

# Google Maps Platform (Maps JavaScript API, Places API (New), Geocoding API)
GOOGLE_MAPS_API_KEY=
# Google Maps Quick Builder Locator Plus embed (provided by hotel)
HOTEL_LOCATOR_PLUS_IFRAME=https://storage.googleapis.com/maps-solutions-er47d39hch/locator-plus/8z5f/locator-plus.html
HOTEL_LAT=
HOTEL_LNG=


# AI Hotel Marketing Assistant (server-side secret, never expose in browser)
OPENAI_API_KEY=
OPENAI_MARKETING_MODEL=gpt-5-mini
